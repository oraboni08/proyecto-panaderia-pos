# Configuración de HDFS (imágenes bde2020, las mismas del taller de HDFS).
# El entrypoint convierte cada variable en una propiedad XML:
#   CORE_CONF_* -> core-site.xml   HDFS_CONF_* -> hdfs-site.xml
#   "_" = "."   "__" = "_"   "___" = "-"

# Memoria máxima de cada proceso Java (NameNode y DataNode).
HADOOP_HEAPSIZE_MAX=256m

# ---------- core-site.xml ----------
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root

# ---------- hdfs-site.xml ----------
# Un solo DataNode por la RAM disponible: cada bloque se guarda 1 vez.
# En producción serían 3 copias en 3 DataNodes (lo que se probó en el taller).
HDFS_CONF_dfs_replication=1
# Bloques de 4 MB para que el histórico (~20 MB) quede en varios bloques
# y Spark lo lea en varias particiones en paralelo.
HDFS_CONF_dfs_blocksize=4194304
# WebHDFS: API REST que usa hdfs-exporter para escribir los CSV.
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
# Detección rápida de un DataNode caído (60 s en vez de ~10 min).
HDFS_CONF_dfs_heartbeat_interval=3
HDFS_CONF_dfs_namenode_heartbeat_recheck___interval=15000
