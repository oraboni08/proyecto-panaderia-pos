# Generado por Ansible (deploy/ansible/back.yml)
# API Gateway: según el inicio de la ruta, reenvía la petición al microservicio correspondiente.

server {
    listen 80 default_server;
    server_name api.{{ domain }} {{ back_ip }};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

{% for service in services %}
    location /api/v1/{{ service.name | replace('-service', '') }}/ {
        proxy_pass http://127.0.0.1:{{ service.port }};
    }

{% endfor %}
    location / {
        default_type application/json;
        return 404 '{"detail": "Ruta no encontrada"}';
    }
}
