* text=auto

# Archivos que se ejecutan o leen dentro de Linux (máquinas virtuales):
# siempre con saltos de línea LF, aunque se clonen en Windows.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.j2        text eol=lf
*.py        text eol=lf
*.txt       text eol=lf
Vagrantfile text eol=lf

*.jpeg binary
*.jpg  binary
*.png  binary
