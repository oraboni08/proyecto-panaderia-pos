[Unit]
Description=Panadería POS - catalog-service
After=network.target

[Service]
User=panaderia
Group=panaderia
WorkingDirectory=/opt/panaderia-pos/catalog-service
EnvironmentFile=/etc/panaderia-pos/catalog-service.env
# Escucha solo en 127.0.0.1: desde fuera se accede únicamente por el API Gateway (Nginx).
ExecStart=/opt/panaderia-pos/venvs/catalog-service/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
