[Unit]
Description=Panadería POS - sales-service
After=network.target

[Service]
User=panaderia
Group=panaderia
WorkingDirectory=/opt/panaderia-pos/sales-service
EnvironmentFile=/etc/panaderia-pos/sales-service.env
# Escucha solo en 127.0.0.1: desde fuera se accede únicamente por el API Gateway (Nginx).
ExecStart=/opt/panaderia-pos/venvs/sales-service/bin/uvicorn app.main:app --host 127.0.0.1 --port 8003
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
